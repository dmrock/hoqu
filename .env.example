# Copy to .env.local and fill in. See README.md for where each value comes from.

# --- Required to run the app ---

# Neon Postgres connection string (pooled)
DATABASE_URL=

# openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# themoviedb.org → Settings → API (movies + TV)
TMDB_API_KEY=

# dev.twitch.tv → Applications (IGDB authenticates through Twitch)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# upstash.com → Redis → REST API (search cache + rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional ---

# resend.com — transactional email (password reset, email change, verification).
# Without it the email client no-ops instead of throwing, so the app still runs.
RESEND_API_KEY=

# Required only for `pnpm test:integration` and `pnpm e2e`. Point it at a
# separate Neon branch — both suites truncate every user table.
E2E_DATABASE_URL=

# Test-suite knobs, rarely set by hand:
#   INTEGRATION_WORKERS       databases created for the integration suite (default 4)
#   E2E_PORT                  port for the Playwright dev server (default 3100)
#   E2E_NEW_RELEASES_FIXTURES set to 1 to stub the Explore new-releases rows
